# Example variables (set these in your OS environment; Qt does not load .env automatically)
FISHING_PORT_ODBC_CONNECTION="Driver={Oracle in XE};Dbq=XE;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;"
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+10000000000"

# Optional EmailJS verification flow
EMAILJS_SERVICE_ID="your_service_id"
EMAILJS_TEMPLATE_ID="your_template_id"
EMAILJS_PUBLIC_KEY="your_public_key"
FISHING_PORT_ALERT_EMAIL="operator@example.com"

# Authorized RFID UID, uppercase hex without separators; unset disables demo badge access
FISHING_PORT_AUTHORIZED_RFID=""
